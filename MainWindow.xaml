<Window x:Class="inwdwhg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="neverlose" Height="320" Width="430"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ExponentialEase x:Key="SnappyEase" EasingMode="EaseOut" Exponent="7"/>

        <!-- Кастомный стиль для ContextMenu -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#121217"/>
            <Setter Property="BorderBrush" Value="#26262B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True"
                                Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кастомный стиль для MenuItem -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="templateBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,6" Margin="0,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateBorder" Property="Background" Value="#1C1C22"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кастомный тонкий скроллбар -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Background="#27272A" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#71717A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="SpinnerTransform" 
                             Storyboard.TargetProperty="Angle" 
                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="WaitSpinAnimation">
            <DoubleAnimation Storyboard.TargetName="WaitSpinnerTransform" 
                             Storyboard.TargetProperty="Angle" 
                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="RootBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation" Completed="FadeOutAnimation_Completed">
            <DoubleAnimation Storyboard.TargetName="RootBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#000000" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="14" Opacity="0">
        <Grid Margin="20">

            <!-- ЭТАП 1: Загрузчик -->
            <Grid x:Name="LoadingGrid" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="44" Height="44" Margin="0,0,0,15">
                        <Ellipse Stroke="#141416" StrokeThickness="3"/>
                        <Ellipse Stroke="White" StrokeThickness="3" StrokeDashArray="12 120" 
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerTransform" CenterX="22" CenterY="22"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="TxtLoadingStatus" Text="Initializing loader..." Foreground="#71717A" FontSize="12" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>

            <!-- ЭТАП 2: Главное меню -->
            <Grid x:Name="MainGrid" Visibility="Collapsed" Opacity="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0">
                    <TextBlock Text="$ourceMafia" Foreground="White" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="Transparent" Foreground="#52525B" BorderThickness="0" 
                            Cursor="Hand" FontSize="12" Width="26" Height="26">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBorder" Property="Background" Value="#1C1C22"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Контент -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Border x:Name="ProductCard" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Background="#08080A" BorderBrush="#1E1E22" BorderThickness="1" CornerRadius="10" Padding="16" Cursor="Hand" MouseLeftButtonDown="ProductCard_Click">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="180" CenterY="30"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0D0D10"/>
                                        <Setter Property="BorderBrush" Value="#2C2C32"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Neverlose crack" Foreground="White" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Lifetime" Foreground="#71717A" FontSize="11" Margin="0,3,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ожидание игры -->
                    <Grid x:Name="WaitingGrid" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="44" Height="44" Margin="0,0,0,15">
                                <Ellipse Stroke="#141416" StrokeThickness="3"/>
                                <Ellipse Stroke="White" StrokeThickness="3" StrokeDashArray="12 120" 
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="WaitSpinnerTransform" CenterX="22" CenterY="22"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="TxtWaitStatus" Text="Waiting for csgo.exe..." Foreground="#71717A" FontSize="12" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Нижняя панель -->
                <Grid Grid.Row="2">
                    <!-- Кнопка папки -->
                    <Button x:Name="BtnCloudFolder" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCloudFolder_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="folderBorder" Background="#0DFFFFFF" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <TextBlock Text="📁" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="folderBorder" Property="Background" Value="#22FFFFFF"/>
                                        <Setter TargetName="folderBorder" Property="BorderBrush" Value="#50FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Кнопка с текстом load -->
                    <Button x:Name="BtnAction" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Width="80" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnAction_Click" IsEnabled="False" Opacity="0.3">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#0DFFFFFF" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <TextBlock Text="load" Foreground="White" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#50FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>

            <!-- ЭТАП 3: Проводник -->
            <Grid x:Name="CloudBrowserGrid" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CloudTransform" X="30"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка браузера -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="←" Click="BtnBackFromCloud_Click"
                                Background="Transparent" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" FontSize="13" Width="28" Height="28" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="backBorder" Background="#0DFFFFFF" CornerRadius="7" BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="backBorder" Property="Background" Value="#22FFFFFF"/>
                                            <Setter TargetName="backBorder" Property="BorderBrush" Value="#50FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TxtBrowserTitle" Text="nl_cloud" Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Список файлов с кастомным контекстным меню -->
                <Border Grid.Row="1" Background="#060608" BorderBrush="#1C1C22" BorderThickness="1" CornerRadius="10" Padding="6">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FilesTransform" X="0"/>
                    </Border.RenderTransform>
                    <ListBox x:Name="FilesListBox" Background="Transparent" BorderThickness="0" Foreground="White" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="FilesListBox_MouseDoubleClick"
                             KeyDown="FilesListBox_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Import File..." Click="CtxImport_Click"/>
                                <MenuItem Header="Share" Click="CtxShare_Click"/>
                                <MenuItem Header="Delete" Click="CtxDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,2" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#16161A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#26262E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#E4E4E7" FontSize="12" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>